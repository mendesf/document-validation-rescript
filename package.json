{
  "name": "document-validation-rescript",
  "version": "0.0.1",
  "scripts": {
    "res:build": "rescript",
    "res:clean": "rescript clean",
    "res:dev": "rescript build -w",
    "ts:build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "ts:clean": "rimraf dist",
    "ts:dev": "nodemon",
    "build": "npm run res:build && npm run ts:build",
    "start": "node dist/index.js"
  },
  "keywords": [
    "rescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "rescript": "*"
  },
  "devDependencies": {
    "gentype": "^4.5.0",
    "nodemon": "^2.0.21",
    "rimraf": "^4.3.0",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.2",
    "tsconfig-paths": "^4.1.2",
    "typescript": "^4.9.5"
  }
}
